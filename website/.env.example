# Ask Clive (legacy public website)
ANTHROPIC_API_KEY=
AIRTABLE_READ_TOKEN=
CLIVE_MODEL=claude-sonnet-4-6

# Court Book: cheap model for verdicts and bickering
COURT_MODEL=claude-haiku-4-5-20251001

# Brain Key — Chapter 1 (see docs/initiatives/brain-key-wiring.md)
BRAIN_KEY_USE_MEMORY=true
BRAIN_KEY_ADMIN_SECRET=local-dev-admin-secret
BRAIN_KEY_DEFAULT_GRANT_MINUTES=15
BRAIN_KEY_DEFAULT_MAX_USES=3

# When bases exist — disable memory store and set scoped tokens:
# BRAIN_KEY_USE_MEMORY=false
BRAIN_REGISTRY_BASE_ID=appbdTVHevH6Bl5ZZ
BRAIN_WORKSHOP_BASE_ID=appL2fdnGmhA02WXd
BRAIN_WORKSHOP_INTERACTIONS_TABLE_ID=tblNqNSuIJ2akHyA1
BRAIN_TRUSTED_DEFAULT_SLUG=astrajax-chapter-1
BRAIN_TRUSTED_BASE_ID=app6tjzzG0L0lOeVb
BRAIN_TRUSTED_CONTEXT_TABLE_ID=tblipHzCl905T7o5F
# BRAIN_REGISTRY_READ_TOKEN=
# BRAIN_KEY_ADMIN_TOKEN=
# Workshop write — required for Receiving Wall Accept (/api/brains/receiving-wall/accept)
# and for filing onboarding uploads into Source Documents
# (/api/onboarding/source-document). Without it the upload still succeeds and
# the route honestly reports saved:false — the file stays in Blob staging only.
# BRAIN_WORKSHOP_WRITE_TOKEN=
# BRAIN_TRUSTED_READ_TOKEN=
# BRAIN_DOC_PROMOTE_TOKEN=
# Optional override when Draft Brain Truth Status gains an "Approved" single-select (default: Approved)
# BRAIN_WORKSHOP_RECEIVING_WALL_ACCEPT_STATUS=Approved

# Clive voice (T1 — see website/docs/clive-voice-t1-build-pack.md)
OPENAI_API_KEY=
CLIVE_TTS_MODEL=gpt-4o-mini-tts
CLIVE_TTS_VOICE=fable
# CLIVE_TTS_INSTRUCTIONS= (optional override of the placeholder voice direction)
NEXT_PUBLIC_CLIVE_VOICE=

# AstraJax Platform sessions and Household Activity telemetry
# Start with both feature flags false; enable only after the Airtable/Vercel setup below is complete.
PLATFORM_SESSION_ENABLED=false
PLATFORM_ACTIVITY_EVENT_WRITES_ENABLED=false
PLATFORM_SESSION_SECRET=
PLATFORM_SESSION_IDLE_MINUTES=30
CRON_SECRET=

# Household Activity base — server-side only; never expose these with NEXT_PUBLIC_.
HOUSEHOLD_ACTIVITY_BASE_ID=appF7jQD4ZKrDC7e1
HOUSEHOLD_SESSIONS_TABLE_ID=tblUi4nmBKX2u8nFx
HOUSEHOLD_ACTIVITY_TABLE_ID=tblNxNLyC31KDQbRl
HOUSEHOLD_ACTIVITY_WRITE_TOKEN=
HOUSEHOLD_ACTIVITY_READ_TOKEN=
HOUSEHOLD_ACTIVITY_REVIEW_TOKEN=

# Public website Blob (Living Folio + furniture). Store id is safe to commit;
# the write token lives only in .env.local — see docs/website-blob-store.md.
AJ_WEBSITE_BLOB_STORE_ID=store_cvu4L5KwtlOCutGD
# AJ_WEBSITE_BLOB_READ_WRITE_TOKEN=

# Durable Vercel Blob leases/outbox + onboarding Source Pack uploads
# (private Blob store — different from AJ_WEBSITE_*).
# OIDC is preferred on Vercel; local may use BLOB_READ_WRITE_TOKEN for this store only.
BLOB_STORE_ID=
# Local only — copy from the main website .env.local. Required for
# POST /api/onboarding/upload (private access) and for the server-side read
# that files those uploads into Workshop Source Documents. Do not commit the
# real value.
# BLOB_READ_WRITE_TOKEN=
# VERCEL_OIDC_TOKEN is supplied by Vercel at runtime when the store is connected.
PLATFORM_SESSION_LEASE_PREFIX=platform-activity/leases/
PLATFORM_ACTIVITY_OUTBOX_PREFIX=platform-activity/outbox/
PLATFORM_ACTIVITY_DLQ_PREFIX=platform-activity/dead-letter/
PLATFORM_ACTIVITY_QUEUE_ALERT_SECONDS=120
PLATFORM_ACTIVITY_MAX_ATTEMPTS=6

# Cutover controls: Brain Interactions stays primary until dual-read validation is complete.
INTERACTION_READ_MODE=brain_only
INTERACTION_WRITE_TARGET=brain_interactions

# Horace-owned rate card. Example shape only; insert approved values before event writes are enabled.
PLATFORM_MODEL_RATE_CARD_JSON=

# Context index (Neon + pgvector) — disposable search layer over Trusted Brain.
# Airtable stays the system of record. Off until Neon is connected and SQL is applied.
# Schema: website/sql/context-index/001_create_schema.sql then 002_sync_schema.sql
CONTEXT_INDEX_SYNC_ENABLED=false
DATABASE_URL=
# Optional: Airtable view that already filters to live/approved Trusted Truth rows.
# CONTEXT_INDEX_TRUSTED_TRUTH_VIEW_ID=
# CONTEXT_INDEX_EMBEDDING_MODEL=text-embedding-3-small
